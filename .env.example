# Mobile / Expo API base URL (include /api/v1).
# Web can omit this and defaults to http://localhost:4000/api/v1.
# Native (device/emulator) must point at your machine's LAN IP, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Optional Socket.IO origin. Leave unset to use the API origin (the URL above without /api/v1).
# Do not put a temporary tunnel hostname here; set it only for a stable public API.
# EXPO_PUBLIC_SOCKET_URL=http://localhost:4000
