# Copy to .env and adjust. Never commit the real .env.

# Postgres connection string. The tests derive their own `test` schema from it.
DATABASE_URL="postgresql://pulseplay:CHANGE_ME@localhost:5432/pulseplay?schema=public"

# Signs session tokens. Use a long random value (e.g. `openssl rand -hex 48`); changing it signs everyone out.
JWT_SECRET="CHANGE_ME"

PORT=4000

# Optional: bcrypt work factor (default 10, minimum 4). Only lower it for tests.
# BCRYPT_COST=10

# Optional external feed overrides (defaults work for free public endpoints).
# BYBIT_BASE_URL=https://api.bybit.com
# COINGECKO_API_URL=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum&vs_currencies=usd&include_24hr_change=true
# THESPORTSDB_API_KEY=3
# THESPORTSDB_FOOTBALL_LEAGUE_ID=4328
# THESPORTSDB_CRICKET_LEAGUE_ID=5176
