# Copy to .env and adjust. Never commit the real .env.

# Postgres connection string. The tests derive their own `test` schema from it.
DATABASE_URL="postgresql://pulseplay:CHANGE_ME@localhost:5432/pulseplay?schema=public"

# Signs session tokens. Use a long random value (e.g. `openssl rand -hex 48`); changing it signs everyone out.
JWT_SECRET="CHANGE_ME"

PORT=4000

# Socket.IO is served by this same process at /socket.io (no separate port).
# One API process uses the in-memory adapter. Do not set SOCKET_REDIS_URL unless a
# Redis adapter package is added; a value here is ignored and logged.
# Required when NODE_ENV=production (browser origins are denied if unset).
# SOCKET_CORS_ORIGINS=https://app.example.com,https://admin.example.com
# SOCKET_MAX_CONNECTIONS=2000
# SOCKET_PING_INTERVAL_MS=25000
# SOCKET_PING_TIMEOUT_MS=20000
# SOCKET_EVENTS_PER_10S=30
# SPORTS_TICKER_STALE_MS=30000
# CRYPTO_FEED_STALE_MS=90000
# FIXTURES_SYNC_STALE_MS=1200000
# CRICKET_STALE_MS=600000
# Clients derive the socket origin from their API URL unless they set their own:
#   mobile: EXPO_PUBLIC_SOCKET_URL (optional; defaults to EXPO_PUBLIC_API_URL without /api/v1)
#   mobile reconnect: EXPO_PUBLIC_SOCKET_RECONNECT_MS=1000
#   admin:  VITE_SOCKET_URL (optional; the Vite dev server proxies /socket.io to this API)

# Optional: bcrypt work factor (default 10, minimum 4). Only lower it for tests.
# BCRYPT_COST=10

# Optional external feed overrides (defaults work for free public endpoints).
# BYBIT_BASE_URL=https://api.bybit.com
# BYBIT_TIMEOUT_MS=8000
# BYBIT_MAX_ATTEMPTS=3
# COINGECKO_API_URL=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum&vs_currencies=usd&include_24hr_change=true
# THESPORTSDB_API_KEY=3
# THESPORTSDB_FOOTBALL_LEAGUE_ID=4328
# THESPORTSDB_CRICKET_LEAGUE_ID=5176

# CricketData.org free plan (server only — never put this key in the mobile app).
# Sign up at https://cricketdata.org/ and copy the free key from the member area.
# The free plan allows 100 hits/day. Scores can lag by about a minute. There is no free WebSocket.
# CRICKET_API_KEY=
# CRICKET_API_BASE=https://api.cricapi.com/v1
# CRICKET_API_PROVIDER=cricapi
# CRICKET_API_LIVE_PATH=/currentMatches?offset=0
# CRICKET_API_INFO_PATH=/match_info
# CRICKET_API_SCORECARD_PATH=/match_scorecard
# CRICKET_API_COMMENTARY_PATH=/match_bbb
# CRICKET_API_TIMEOUT_MS=10000
# CRICKET_POLL_INTERVAL_MS=180000
# CRICKET_API_DAILY_HIT_CAP=80
