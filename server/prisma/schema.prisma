generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LookupType {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  isDeleted Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lookups   Lookup[]
}

model Lookup {
  id                                                          Int                 @id @default(autoincrement())
  lookupTypeId                                                Int
  code                                                        String
  label                                                       String
  sortOrder                                                   Int                 @default(0)
  isDeleted                                                   Int                 @default(0)
  createdAt                                                   DateTime            @default(now())
  updatedAt                                                   DateTime @updatedAt
  Bet                                                         Bet[]
  Event_Event_categoryIdToLookup                              Event[]             @relation("Event_categoryIdToLookup")
  Event_Event_statusIdToLookup                                Event[]             @relation("Event_statusIdToLookup")
  lookupType                                                  LookupType          @relation(fields: [lookupTypeId], references: [id])
  Market                                                      Market[]
  MarketSelection                                             MarketSelection[]
  Notification                                                Notification[]
  Wallet                                                      Wallet[]
  WalletLedger_WalletLedger_referenceTypeIdToLookup           WalletLedger[]      @relation("WalletLedger_referenceTypeIdToLookup")
  WalletLedger_WalletLedger_statusIdToLookup                  WalletLedger[]      @relation("WalletLedger_statusIdToLookup")
  WalletLedger_WalletLedger_transactionTypeIdToLookup         WalletLedger[]      @relation("WalletLedger_transactionTypeIdToLookup")
  WalletRequest_WalletRequest_statusIdToLookup                WalletRequest[]     @relation("WalletRequest_statusIdToLookup")
  WalletRequest_WalletRequest_typeIdToLookup                  WalletRequest[]     @relation("WalletRequest_typeIdToLookup")
  WalletTransaction_WalletTransaction_referenceTypeIdToLookup WalletTransaction[] @relation("WalletTransaction_referenceTypeIdToLookup")
  WalletTransaction_WalletTransaction_statusIdToLookup        WalletTransaction[] @relation("WalletTransaction_statusIdToLookup")
  WalletTransaction_WalletTransaction_typeIdToLookup          WalletTransaction[] @relation("WalletTransaction_typeIdToLookup")

  @@unique([lookupTypeId, code])
  @@index([lookupTypeId])
}

model User {
  id                                     Int                 @id @default(autoincrement())
  name                                   String
  userCode                               String              @unique
  email                                  String              @unique
  mobile                                 String              @unique
  avatarUrl                              String?
  passwordHash                           String
  ipAddress                              String?
  lastLoginAt                            DateTime?
  isDeleted                              Int                 @default(0)
  createdAt                              DateTime            @default(now())
  updatedAt                              DateTime            @updatedAt
  roleId                                 Int
  clientId                               Int?
  isActive                               Int                 @default(1)
  mustChangePassword                     Int                 @default(0)
  passwordChangedAt                      DateTime?
  createdByUserId                        Int?
  modifiedByUserId                       Int?
  bets                                   Bet[]
  Client_Client_createdByUserIdToUser    Client[]            @relation("Client_createdByUserIdToUser")
  Client_Client_modifiedByUserIdToUser   Client[]            @relation("Client_modifiedByUserIdToUser")
  Market                                 Market[]
  MarketSelection                        MarketSelection[]
  notifications                          Notification[]
  client                                 Client?             @relation("User_clientIdToClient", fields: [clientId], references: [id])
  User_User_createdByUserIdToUser        User?               @relation("User_createdByUserIdToUser", fields: [createdByUserId], references: [id])
  other_User_User_createdByUserIdToUser  User[]              @relation("User_createdByUserIdToUser")
  User_User_modifiedByUserIdToUser       User?               @relation("User_modifiedByUserIdToUser", fields: [modifiedByUserId], references: [id])
  other_User_User_modifiedByUserIdToUser User[]              @relation("User_modifiedByUserIdToUser")
  Role                                   Role                @relation(fields: [roleId], references: [id])
  wallet                                 Wallet?
  WalletLedger                           WalletLedger[]
  WalletRequest                          WalletRequest[]
  WalletTransaction                      WalletTransaction[]
  passwordResetTokens                    PasswordResetToken[]

  @@index([clientId, roleId, isDeleted])
}

model Event {
  id                              Int      @id @default(autoincrement())
  externalId                      String?  @unique
  categoryId                      Int
  name                            String
  competition                     String
  startTime                       DateTime
  statusId                        Int
  scoreLabel                      String?
  minuteLabel                     String?
  homeTeamName                    String?
  homeTeamShort                   String?
  homeScore                       String?
  awayTeamName                    String?
  awayTeamShort                   String?
  awayScore                       String?
  symbol                          String?
  changePercent24h                Decimal? @db.Decimal(8, 4)
  isDeleted                       Int      @default(0)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime            @updatedAt
  Lookup_Event_categoryIdToLookup Lookup   @relation("Event_categoryIdToLookup", fields: [categoryId], references: [id])
  Lookup_Event_statusIdToLookup   Lookup   @relation("Event_statusIdToLookup", fields: [statusId], references: [id])
  markets                         Market[]

  @@index([categoryId])
  @@index([statusId])
}

model Market {
  id               Int               @id @default(autoincrement())
  eventId          Int
  marketType       String
  name             String
  statusId         Int
  version          Int               @default(1)
  isDeleted        Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  modifiedByUserId   Int?
  winningSelectionId Int?
  legs               BetSelectionLeg[]
  event            Event             @relation(fields: [eventId], references: [id])
  User             User?             @relation(fields: [modifiedByUserId], references: [id])
  Lookup           Lookup            @relation(fields: [statusId], references: [id])
  selections       MarketSelection[]

  @@index([eventId])
  @@index([statusId])
}

model MarketSelection {
  id               Int      @id @default(autoincrement())
  marketId         Int
  code             String
  name             String
  currentPrice     Decimal  @db.Decimal(8, 4)
  priceVersion     Int      @default(1)
  statusId         Int
  sortOrder        Int      @default(0)
  isDeleted        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  modifiedByUserId Int?
  market           Market   @relation(fields: [marketId], references: [id])
  User             User?    @relation(fields: [modifiedByUserId], references: [id])
  Lookup           Lookup   @relation(fields: [statusId], references: [id])

  @@index([marketId])
  @@index([statusId])
}

model Bet {
  id              Int               @id @default(autoincrement())
  userId          Int
  stake           Decimal           @db.Decimal(14, 2)
  combinedOdds    Decimal           @db.Decimal(8, 4)
  potentialReturn Decimal           @db.Decimal(14, 2)
  statusId        Int
  legCount        Int
  placedAt        DateTime          @default(now())
  settledAt       DateTime?
  updatedAt       DateTime          @updatedAt
  clientId        Int
  Client          Client            @relation(fields: [clientId], references: [id])
  Lookup          Lookup            @relation(fields: [statusId], references: [id])
  user            User              @relation(fields: [userId], references: [id])
  selections      BetSelectionLeg[]

  @@index([userId])
  @@index([clientId, placedAt(sort: Desc)])
  @@index([statusId])
}

model BetSelectionLeg {
  id              Int     @id @default(autoincrement())
  betId           Int
  eventId         Int
  eventName       String
  marketId        Int
  marketName      String
  selectionId     Int
  selectionName   String
  oddsAtPlacement Decimal @db.Decimal(8, 4)
  bet             Bet     @relation(fields: [betId], references: [id])
  market          Market  @relation(fields: [marketId], references: [id])

  @@index([betId])
  @@index([marketId])
}

model Wallet {
  id               Int                 @id @default(autoincrement())
  userId           Int                 @unique
  currency         String
  availableBalance Decimal             @db.Decimal(14, 2)
  lockedBalance    Decimal             @db.Decimal(14, 2)
  version          Int                 @default(1)
  statusId         Int
  isDeleted        Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  Lookup           Lookup              @relation(fields: [statusId], references: [id])
  user             User                @relation(fields: [userId], references: [id])
  ledger           WalletLedger[]
  requests         WalletRequest[]
  transactions     WalletTransaction[]

  @@index([statusId])
}

model WalletTransaction {
  id                                               Int      @id @default(autoincrement())
  walletId                                         Int
  userId                                           Int
  typeId                                           Int
  amount                                           Decimal  @db.Decimal(14, 2)
  referenceTypeId                                  Int?
  referenceId                                      String?
  statusId                                         Int
  createdAt                                        DateTime @default(now())
  createdByUserId                                  Int?
  User                                             User?    @relation(fields: [createdByUserId], references: [id])
  Lookup_WalletTransaction_referenceTypeIdToLookup Lookup?  @relation("WalletTransaction_referenceTypeIdToLookup", fields: [referenceTypeId], references: [id])
  Lookup_WalletTransaction_statusIdToLookup        Lookup   @relation("WalletTransaction_statusIdToLookup", fields: [statusId], references: [id])
  Lookup_WalletTransaction_typeIdToLookup          Lookup   @relation("WalletTransaction_typeIdToLookup", fields: [typeId], references: [id])
  wallet                                           Wallet   @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([userId])
  @@index([statusId])
  @@index([typeId])
}

model WalletLedger {
  id                                            Int      @id @default(autoincrement())
  walletId                                      Int
  userId                                        Int
  transactionTypeId                             Int
  amount                                        Decimal  @db.Decimal(14, 2)
  beforeAvailable                               Decimal  @db.Decimal(14, 2)
  afterAvailable                                Decimal  @db.Decimal(14, 2)
  beforeLocked                                  Decimal  @db.Decimal(14, 2)
  afterLocked                                   Decimal  @db.Decimal(14, 2)
  referenceTypeId                               Int?
  referenceId                                   String?
  statusId                                      Int
  createdAt                                     DateTime @default(now())
  createdByUserId                               Int?
  User                                          User?    @relation(fields: [createdByUserId], references: [id])
  Lookup_WalletLedger_referenceTypeIdToLookup   Lookup?  @relation("WalletLedger_referenceTypeIdToLookup", fields: [referenceTypeId], references: [id])
  Lookup_WalletLedger_statusIdToLookup          Lookup   @relation("WalletLedger_statusIdToLookup", fields: [statusId], references: [id])
  Lookup_WalletLedger_transactionTypeIdToLookup Lookup   @relation("WalletLedger_transactionTypeIdToLookup", fields: [transactionTypeId], references: [id])
  wallet                                        Wallet   @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([transactionTypeId])
}

model WalletRequest {
  id                                    Int       @id @default(autoincrement())
  walletId                              Int
  userId                                Int
  typeId                                Int
  amount                                Decimal   @db.Decimal(14, 2)
  reason                                String
  statusId                              Int
  requestedAt                           DateTime  @default(now())
  resolvedAt                            DateTime?
  clientId                              Int
  resolvedByUserId                      Int?
  Client                                Client    @relation(fields: [clientId], references: [id])
  User                                  User?     @relation(fields: [resolvedByUserId], references: [id])
  Lookup_WalletRequest_statusIdToLookup Lookup    @relation("WalletRequest_statusIdToLookup", fields: [statusId], references: [id])
  Lookup_WalletRequest_typeIdToLookup   Lookup    @relation("WalletRequest_typeIdToLookup", fields: [typeId], references: [id])
  wallet                                Wallet    @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([userId])
  @@index([clientId, statusId, requestedAt(sort: Desc)])
  @@index([statusId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  typeId    Int
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  Lookup    Lookup   @relation(fields: [typeId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([typeId])
}

model PriceHistory {
  id        Int      @id @default(autoincrement())
  symbol    String
  timestamp DateTime
  price     Decimal  @db.Decimal(14, 2)

  @@index([symbol, timestamp])
}

model Client {
  id                                 Int             @id @default(autoincrement())
  code                               String          @unique
  name                               String
  isActive                           Int             @default(1)
  isDeleted                          Int             @default(0)
  createdAt                          DateTime        @default(now())
  updatedAt                          DateTime        @updatedAt
  createdByUserId                    Int?
  modifiedByUserId                   Int?
  Bet                                Bet[]
  User_Client_createdByUserIdToUser  User?           @relation("Client_createdByUserIdToUser", fields: [createdByUserId], references: [id])
  User_Client_modifiedByUserIdToUser User?           @relation("Client_modifiedByUserIdToUser", fields: [modifiedByUserId], references: [id])
  users                              User[]          @relation("User_clientIdToClient")
  WalletRequest                      WalletRequest[]
}

model Role {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  isDeleted Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User[]
}

// Hashed one-time reset tokens for forgot-password. Plain tokens are never stored.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}
